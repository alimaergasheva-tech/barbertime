# Copy to .env and fill in. Never commit .env.
# Supabase → Project → Connect → ORMs → Prisma

# Runtime: pooled connection (Supavisor transaction mode, port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations: session-mode / direct connection (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Storage (server only). Supabase → Project Settings → API
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Admin account created by `npm run db:seed` (a random password is printed if empty)
ADMIN_LOGIN="admin"
ADMIN_PASSWORD=""

# Telegram: token from @BotFather (server only)
TELEGRAM_BOT_TOKEN=""
# Enables POST /telegram/webhook; 16-256 chars of A-Z a-z 0-9 _ -  (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=""
# Supabase Cron → notifications Edge Function auth (openssl rand -hex 32)
CRON_SECRET=""
# Origin of the Telegram Mini App (local Vite or tunnel URL); allowed by API CORS
MINIAPP_URL="http://localhost:5173"
# Fastify API (apps/api): CORS allows APP_URL; apps/web reads API_URL from its own .env.local
APP_URL="http://localhost:3000"
# Public https API URL makes `npm run bot:setup` register the webhook
API_URL="http://localhost:4000"
PORT=4000
