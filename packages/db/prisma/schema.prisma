generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  confirmed
  completed
  cancelled
  no_show

  @@map("booking_status")
}

enum BookingSource {
  web
  telegram
  admin

  @@map("booking_source")
}

enum TimeOffType {
  day_off
  vacation
  sick
  holiday
  other

  @@map("time_off_type")
}

model Barber {
  id                    String    @id @default(cuid())
  name                  String
  photoUrl              String?   @map("photo_url")
  bio                   String    @default("")
  experienceYears       Int       @default(0) @map("experience_years")
  specialties           String[]  @default([])
  telegramChatId        BigInt?   @map("telegram_chat_id")
  /// SHA-256 of the one-time code from t.me/<bot>?start=barber_<code>
  telegramLinkCodeHash  String?   @unique @map("telegram_link_code_hash")
  telegramLinkExpiresAt DateTime? @map("telegram_link_expires_at") @db.Timestamptz(3)
  isActive              Boolean   @default(true) @map("is_active")
  sortOrder             Int       @default(0) @map("sort_order")

  services     BarberService[]
  portfolio    PortfolioItem[]
  workingHours WorkingHours[]
  breaks       Break[]
  timeOff      TimeOff[]
  bookings     Booking[]
  reviews      Review[]

  @@map("barbers")
}

model PortfolioItem {
  id        String @id @default(uuid()) @db.Uuid
  barberId  String @map("barber_id")
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("portfolio_items")
}

model Service {
  id          String  @id @default(cuid())
  name        String
  description String  @default("")
  durationMin Int     @map("duration_min")
  price       Int
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  barbers         BarberService[]
  bookingServices BookingService[]

  @@map("services")
}

/// Per-barber overrides: null duration/price fall back to the service defaults.
model BarberService {
  barberId    String  @map("barber_id")
  serviceId   String  @map("service_id")
  durationMin Int?    @map("duration_min")
  price       Int?
  isEnabled   Boolean @default(true) @map("is_enabled")

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
  @@map("barber_services")
}

/// weekday: ISO 1 = Monday … 7 = Sunday, times are shop-local (Asia/Tashkent).
model WorkingHours {
  id        String   @id @default(uuid()) @db.Uuid
  barberId  String   @map("barber_id")
  weekday   Int      @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday])
  @@map("working_hours")
}

model Break {
  id        String   @id @default(uuid()) @db.Uuid
  barberId  String   @map("barber_id")
  weekday   Int      @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
  @@map("breaks")
}

/// barberId = null means the whole shop is closed.
model TimeOff {
  id       String      @id @default(uuid()) @db.Uuid
  barberId String?     @map("barber_id")
  startsAt DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime    @map("ends_at") @db.Timestamptz(3)
  type     TimeOffType @default(day_off)
  note     String?

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt])
  @@map("time_off")
}

model Client {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  phone          String   @unique
  telegramId     BigInt?  @unique @map("telegram_id")
  telegramChatId BigInt?  @map("telegram_chat_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  bookings Booking[]
  reviews  Review[]

  @@map("clients")
}

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  clientId         String        @map("client_id") @db.Uuid
  barberId         String        @map("barber_id")
  startsAt         DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime      @map("ends_at") @db.Timestamptz(3)
  totalPrice       Int           @map("total_price")
  totalDurationMin Int           @map("total_duration_min")
  status           BookingStatus @default(confirmed)
  source           BookingSource @default(web)
  manageToken      String        @unique @map("manage_token")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  reminderDaySentAt DateTime? @map("reminder_day_sent_at") @db.Timestamptz(3)
  reminder30mSentAt DateTime? @map("reminder_30m_sent_at") @db.Timestamptz(3)
  reviewRequestedAt DateTime? @map("review_requested_at") @db.Timestamptz(3)
  autoCompletedAt   DateTime? @map("auto_completed_at") @db.Timestamptz(3)

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  barber   Barber           @relation(fields: [barberId], references: [id], onDelete: Restrict)
  services BookingService[]
  review   Review?

  @@index([barberId, startsAt])
  @@index([clientId])
  @@index([status, startsAt])
  @@map("bookings")
}

/// Snapshot of the service at booking time, so later price edits don't rewrite history.
model BookingService {
  bookingId   String @map("booking_id") @db.Uuid
  serviceId   String @map("service_id")
  name        String
  durationMin Int    @map("duration_min")
  price       Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([bookingId, serviceId])
  @@map("booking_services")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  barberId  String   @map("barber_id")
  clientId  String   @map("client_id") @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([barberId, isPublic])
  @@map("reviews")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model AdminUser {
  id             String  @id @default(uuid()) @db.Uuid
  login          String  @unique
  passwordHash   String  @map("password_hash")
  telegramChatId BigInt? @map("telegram_chat_id")

  sessions AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  /// SHA-256 of the session token; the token itself lives only in the httpOnly cookie
  id        String   @id
  adminId   String   @map("admin_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}
