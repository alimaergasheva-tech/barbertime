{
  "name": "@barbershop/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "build:vercel": "node scripts/build-vercel.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration --no-file-parallelism",
    "bot:polling": "tsx --env-file-if-exists=../../.env src/telegram/cli/polling.ts",
    "bot:setup": "tsx --env-file-if-exists=../../.env src/telegram/cli/setup.ts",
    "bot:barber-link": "tsx --env-file-if-exists=../../.env src/telegram/cli/barber-link.ts",
    "notifications:run": "tsx --env-file-if-exists=../../.env src/notifications/run.ts",
    "notifications:schedule": "tsx --env-file-if-exists=../../.env src/notifications/schedule.ts",
    "notifications:deploy": "tsx --env-file-if-exists=../../.env src/notifications/deploy.ts",
    "admin:create": "tsx --env-file-if-exists=../../.env src/admin/cli/create.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vercel/nft": "^1.11.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@barbershop/db": "^0.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.3",
    "@node-rs/argon2": "^2.2.2",
    "@vercel/functions": "^3.9.11",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "zod": "^4.6.5"
  }
}
